FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
# Test host only: the application still runs its bundled Python and solver.
# Include Ubuntu's hwloc plugins to exercise the host/plugin boundary.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-minimal libhwloc-plugins xvfb xauth fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
